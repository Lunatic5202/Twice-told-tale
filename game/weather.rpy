################################################################################
## Twice-Told Tale - Weather & Particle Atmosphere
################################################################################
##
## Particle weather that follows the scene: snow through the winter pages,
## embers rising off the forge, leaves drifting through the courtyards, and a
## fine drizzle in the mist corridors.
##
## The technique is Ren'Py's own `SnowBlossom`, so no third-party tool or asset
## is required. The layer is chosen purely from the background on screen: the
## script never has to show or hide anything, it just changes the `bg` and the
## weather follows. Nothing here is required for the story to run.

init offset = -1


## ----------------------------------------------------------------------------
## Particle sprites
## ----------------------------------------------------------------------------
## Regenerated by tools/make_gui_assets.py (game/gui/particle/).

image weather_rain = SnowBlossom(
    "gui/particle/rain.png", count=170, border=380,
    xspeed=(-58, -18), yspeed=(760, 1150), fast=True, animation=True)

image weather_snow = SnowBlossom(
    "gui/particle/snow.png", count=80, border=300,
    xspeed=(-40, 44), yspeed=(52, 118), animation=True)

image weather_embers = SnowBlossom(
    "gui/particle/ember.png", count=60, border=260,
    xspeed=(-22, 22), yspeed=(-165, -55), animation=True)

image weather_leaves = SnowBlossom(
    "gui/particle/leaf.png", count=42, border=320,
    xspeed=(-78, 12), yspeed=(48, 104), animation=True)


## ----------------------------------------------------------------------------
## Which weather each background wants
## ----------------------------------------------------------------------------
## Backgrounds not listed stay clear (interiors, the lab, the white page). Add
## to this table as new art arrives; the value is the suffix of the matching
## `weather_*` image above.

init python:
    WEATHER_BY_BG = {
        # a fine drizzle in the mist corridors
        "corridor_mist":       "rain",
        # falling snow through the winter of Tatarasuna
        "corridor_mist_snow":  "snow",
        "montage":             "snow",
        "small_house":         "snow",
        "small_house_dark":    "snow",
        "house_dawn":          "snow",
        # embers and ash over the forge
        "cinders_path":        "embers",
        "mikage_furnace":      "embers",
        "furnace_morning":     "embers",
        "furnace_room":        "embers",
        "furnace_yard_night":  "embers",
        "furnace_yard_warped": "embers",
        "shrine_night":        "embers",
        "white_page_burn":     "embers",
        # leaves on the Sumeru air
        "akademiya_dawn":      "leaves",
        "courtyard_day":       "leaves",
        "green_corridor":      "leaves",
        "rooftop_night":       "leaves",
        "shakkei_pavilion":    "leaves",
        "veranda":             "leaves",
        "white_page_street":   "leaves",
    }

    def current_weather():
        """The particle layer wanted by the background on screen, or None.
        Returns None while a menu is open, in Reduce Motion, or when the player
        has turned Particle Effects off."""
        if main_menu or renpy.get_screen("game_menu"):
            return None
        if getattr(persistent, "reduce_motion", False):
            return None
        if not getattr(persistent, "particle_effects", True):
            return None

        attrs = renpy.get_attributes("bg")
        if not attrs:
            return None
        return WEATHER_BY_BG.get(attrs[-1])


## ----------------------------------------------------------------------------
## Preference
## ----------------------------------------------------------------------------
## Particle weather is pure atmosphere, so it gets its own switch next to Reduce
## Motion rather than being tied to it.

default persistent.particle_effects = True

init python:
    class ToggleParticles(Action):
        def __call__(self):
            persistent.particle_effects = not getattr(persistent, "particle_effects", True)
            renpy.restart_interaction()

        def get_selected(self):
            return bool(getattr(persistent, "particle_effects", True))


## ----------------------------------------------------------------------------
## The weather layer
## ----------------------------------------------------------------------------
## Shown above the scene art but below the dialogue and menu UI (the same band
## as the ambient dust). The image is declared once above, so the particles keep
## drifting across a background change instead of restarting from scratch.

screen weather():
    zorder -1

    $ _weather_kind = current_weather()
    if _weather_kind:
        add "weather_" + _weather_kind


init python:
    if "weather" not in config.overlay_screens:
        config.overlay_screens.append("weather")
